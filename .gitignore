public/
# This repo's own gate builds into a mktemp root, so it never writes here.
# themes/typikon/bin/typikon-check does — it builds public-local/ into the
# consumer worktree — and that script is a documented entry point.
public-local/
# Zola's Giallo highlighter writes its generated theme stylesheet
# into static/ (not just public/) as a `zola build` side effect when
# [markdown.highlighting] style = "class" — verified against the
# pinned Zola 0.23.3 binary. Unused here: static/css/syntax.css
# supplies this site's own three-ink pass over the emitted classes
# instead of this stock theme's colors (config.toml's own comment has
# the full note). Regenerates deterministically on every build; never
# hand-edit it.
static/giallo.css
.zola-cache/
.kanon/
.DS_Store
*.swp
node_modules/
.lycheecache
test-results/
playwright-report/
.playwright/
.wrangler/
*.local
.env
.env.local
target/
__pycache__/
*.bak
.claude/
